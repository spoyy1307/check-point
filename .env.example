# ==========================================
# Smart Visitor - Checkpoint Patrol Mobile
# Environment Configuration Template (.env.example)
# ==========================================

# 1. API Base URL (กำหนด URL ของระบบ Backend API)
EXPO_PUBLIC_API_BASE_URL=https://api.smartvisitor-security.com/api/v1

# 2. API Key / Authorization Token
EXPO_PUBLIC_API_KEY=smart_visitor_patrol_key_2026

# 3. API Request Timeout (มิลลิวินาที)
EXPO_PUBLIC_API_TIMEOUT=15000

# 4. ข้อมูลสาขา / โครงการ
EXPO_PUBLIC_BRANCH_ID=BR-001
EXPO_PUBLIC_BRANCH_NAME=โรงงานสาขาใหญ่ กิ่งแก้ว

# 5. สายด่วนศูนย์ควบคุมความปลอดภัย 24 ชม. (SOC)
EXPO_PUBLIC_SOC_HOTLINE=191
EXPO_PUBLIC_SOC_SUPERVISOR_PHONE=081-234-5678
